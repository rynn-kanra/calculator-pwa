{
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "target": "ESNext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "strict": true,
    "esModuleInterop": true,
    "noEmit": true,
    "allowJs": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "lib": [
      "ESNext",
      "WebWorker",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "bun",
      "dom-serial",
      "w3c-web-hid",
      "w3c-web-usb",
      "web",
      "web-bluetooth"
    ]
  },
  "include": [
    "src",
    "types/**/*.d.ts"
  ],
}